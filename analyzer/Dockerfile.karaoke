ARG BASE_IMAGE=python:3.12-slim
# The compilers some separation packages need are only used to build them; the running image leaves them out.
FROM ${BASE_IMAGE} AS build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
    torch==2.5.1 torchaudio==2.5.1 torchvision==0.20.1
RUN pip install --no-cache-dir "audio-separator[cpu]==0.30.2" "torch==2.5.1" \
    "numpy==1.26.4" "onnxruntime==1.20.1" "fastapi==0.115.6" "uvicorn==0.34.0" "requests==2.32.3"

FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 rubberband-cli \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
WORKDIR /app
COPY entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod 755 /entrypoint.sh
COPY karaoke.py karaoke_proxy.py karaoke_worker.py mashup.py mashup_worker.py server_*.py test_karaoke.py \
    test_karaoke_worker.py test_mashup.py test_mashup_worker.py ./
ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMBA_NUM_THREADS=1 \
    DATA_DIR=/data PYTHONUNBUFFERED=1
HEALTHCHECK --interval=60s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8788/healthz', timeout=8)"
ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "karaoke:app", "--host", "0.0.0.0", "--port", "8788", "--no-access-log"]
